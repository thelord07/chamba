{
  "name": "@chamba/adapters",
  "version": "0.12.0",
  "description": "Node implementations of @chamba/core ports (filesystem, process, clock)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelord07/chamba.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/thelord07/chamba#readme",
  "bugs": {
    "url": "https://github.com/thelord07/chamba/issues"
  },
  "keywords": [
    "chamba",
    "mcp",
    "adapters",
    "node"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chamba/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
