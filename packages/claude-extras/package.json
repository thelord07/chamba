{
  "name": "@chamba/claude-extras",
  "version": "0.0.0",
  "description": "Optional Claude Code extras for chamba: slash commands, subagents and hooks installer",
  "license": "MIT",
  "type": "module",
  "bin": {
    "chamba-install": "./bin/chamba-install"
  },
  "files": [
    "dist",
    "bin",
    "assets"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
