{
  "name": "@chamba/opencode-extras",
  "version": "1.5.0",
  "description": "Optional OpenCode extras for chamba: slash commands + subagents installer",
  "license": "MIT",
  "type": "module",
  "bin": {
    "chamba-opencode": "./bin/chamba-opencode"
  },
  "files": [
    "dist",
    "bin",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelord07/chamba.git",
    "directory": "packages/opencode-extras"
  },
  "homepage": "https://github.com/thelord07/chamba#readme",
  "bugs": {
    "url": "https://github.com/thelord07/chamba/issues"
  },
  "keywords": [
    "chamba",
    "opencode",
    "mcp",
    "slash-commands",
    "subagents"
  ],
  "scripts": {
    "build": "node scripts/copy-assets.mjs && tsup src/cli.ts --format esm --clean",
    "test": "node scripts/copy-assets.mjs && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chamba/adapters": "workspace:*",
    "@chamba/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
