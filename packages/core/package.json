{
  "name": "@chamba/core",
  "version": "0.8.0",
  "description": "Core logic for chamba: workspace scanner, plan + heuristic reviewer, git worktrees, Obsidian, memory — no Node APIs, no LLM",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelord07/chamba.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/thelord07/chamba#readme",
  "bugs": {
    "url": "https://github.com/thelord07/chamba/issues"
  },
  "keywords": [
    "chamba",
    "mcp",
    "ai",
    "agent",
    "workspace",
    "obsidian",
    "git-worktree"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
