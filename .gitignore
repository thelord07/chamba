# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
~/.chamba/logs/

# Env
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
.idea/
*.swp

# User chamba dir (never commit, except examples/)
.chamba/
!examples/**/.chamba/

# Obsidian vault artifacts — chamba can bootstrap a vault at the repo root
# (.obsidian + a seeded overview). Never commit a personal vault into this repo.
# `plans/*.md` (planning docs) stay tracked; vault note subfolders don't.
.obsidian/
/Workspace overview.md
/proyectos/
/plans/*/
